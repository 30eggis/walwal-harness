{
  "harness": {
    "name": "walwal-harness — NEXUS company harness",
    "version": "7.1.1",
    "description": "v7 company harness. Owner uses /goal or /hot-fix, CEO coordinates CXX agents, CXX agents use resource-manager/hiring, and hired workers produce mission evidence under .harness/documents/{mission}/workers/.",
    "source": "https://www.anthropic.com/engineering/harness-design-long-running-apps"
  },
  "agents": {
    "ceo": { "role": "Owner-facing mission intake, CXX orchestration, and final reports", "skill": "harness-ceo", "model": "sonnet" },
    "coo": { "role": "Planning, research, hypothesis, mission fit", "skill": "harness-coo", "model": "sonnet" },
    "cdo": { "role": "Branding, UI/UX, design review", "skill": "harness-cdo", "model": "sonnet" },
    "cto": { "role": "Architecture, platform, API, implementation coordination", "skill": "harness-cto", "model": "opus" },
    "cqo": { "role": "Quality gates, regression, archive criteria", "skill": "harness-cqo", "model": "opus" },
    "ops": { "role": "Build/service environment monitoring and exception logging", "skill": "harness-ops", "model": "sonnet" },
    "hiring": { "role": "Hire missing workers from HR-Resource", "skill": "harness-hiring", "model": "sonnet" },
    "resource-manager": { "role": "Resolve hired-worker availability and invocation wording", "skill": "harness-resource-manager", "model": "haiku" },
    "brick-office": { "role": "Company status and dashboard support", "skill": "harness-brick-office", "model": "haiku" }
  },
  "flow": {
    "sequence": ["ceo", "coo", "cdo", "cto", "cqo", "ops"],
    "worker_gate": "CXX agents must use harness-resource-manager and harness-hiring before specialist deliverables.",
    "worker_reports_required": ".harness/documents/{mission}/workers/{worker-name}.md",
    "retry_on_fail": true,
    "max_retries_per_sprint": 5,
    "escalate_to_ceo_after": 3,
    "archive_on_sprint_complete": true,
    "pre_eval_gate": {
      "comment": "Generator → Evaluator 전환 전 결정론적 검증. 실패 시 Evaluator 세션을 열지 않고 Generator로 자동 리라우팅.",
      "enabled": true,
      "backend_checks": ["npx tsc --noEmit", "npx eslint . --max-warnings=0", "npx jest --bail --passWithNoTests"],
      "backend_cwd": "",
      "frontend_checks": ["npx tsc --noEmit", "npx eslint . --max-warnings=0", "npx vitest run --bail 1"],
      "frontend_cwd": "",
      "timeout_seconds": 120,
      "on_fail": "reroute_to_generator"
    },
    "team": {
      "comment": "Company worker pool 설정. 회사모드에서 항상 사용.",
      "concurrency": 3,
      "max_retries_per_feature": 5,
      "escalate_after": 3,
      "auto_dequeue": true,
      "gen_model": "sonnet",
      "eval_model": "opus",
      "branch_strategy": "feature-branch",
      "merge_on_pass": true,
      "rebase_on_conflict": true
    }
  },
  "evaluation": {
    "comment": "Evaluator 공통 설정",
    "scoring": {
      "scale": 3,
      "pass_threshold": 2.80,
      "fail_threshold": 2.79,
      "verdict_rules": [
        "Weighted Score < 2.80 → FAIL",
        "AC Pass Rate < 100% → FAIL (부분 통과 불인정)",
        "Regression Failures > 0 → FAIL (신규 점수 무관)",
        "Evidence 누락 항목 → 해당 Score = 0으로 재계산",
        "Cross-Validation 불일치 > 0 → CONDITIONAL FAIL"
      ]
    },
    "regression": {
      "enabled": true,
      "source": "archive",
      "scope": "all_passed_features",
      "comment": "이전 Sprint에서 PASS된 모든 AC를 현재 Sprint에서 재검증. 1건이라도 실패하면 전체 FAIL."
    },
    "cross_validation": {
      "enabled": true,
      "comment": "evaluator-code-quality / evaluator-functional / evaluator-visual 세 평가자의 결과를 상호 참조하여 불일치를 감지. evaluation-*.md의 Cross-Validation Data JSON 블록을 기계적으로 파싱."
    },
    "acceptance_criteria_schema": {
      "comment": "Planner가 feature-list.json에 기능 정의 시 반드시 작성해야 하는 실행 가능한 검증 조건 스키마. Evaluator는 이 조건을 기계적으로 실행한다.",
      "required_fields": ["id", "description", "type", "verify"],
      "types": {
        "api": {
          "verify_fields": ["method", "path", "body", "expect"],
          "expect_fields": ["status"],
          "optional_expect": ["body_contains", "body_schema", "headers"]
        },
        "visual": {
          "verify_fields": ["url", "elements"],
          "optional_verify": ["viewport", "state", "screenshot_match"]
        },
        "e2e": {
          "verify_fields": ["steps"],
          "step_fields": ["action", "target", "value", "expect"]
        }
      },
      "example": {
        "id": "AC-001",
        "description": "유효한 이메일로 가입 시 201 응답",
        "type": "api",
        "verify": {
          "method": "POST",
          "path": "/api/auth/register",
          "body": { "email": "test-{{timestamp}}@test.com", "password": "Test1234!" },
          "expect": { "status": 201, "body_contains": { "id": "string", "email": "string" } }
        }
      },
      "negative_example": {
        "id": "AC-002",
        "description": "중복 이메일 시 409 응답",
        "type": "api",
        "verify": {
          "method": "POST",
          "path": "/api/auth/register",
          "body": { "email": "duplicate@test.com", "password": "Test1234!" },
          "expect": { "status": 409 }
        },
        "is_negative": true
      },
      "visual_example": {
        "id": "AC-003",
        "description": "회원가입 폼 렌더링 확인",
        "type": "visual",
        "verify": {
          "url": "/register",
          "elements": ["input[name=email]", "input[name=password]", "button[type=submit]"],
          "viewport": [375, 768, 1280]
        }
      }
    }
  },
  "artifacts": {
    "comment": "아티팩트 상태 머신. 각 에이전트 실행 전 선행 아티팩트가 required_status 이상인지 검증.",
    "states": ["pending", "draft", "reviewed", "approved"],
    "prerequisites": {
      "generator-backend": {
        "plan.md": "draft",
        "api-contract.json": "draft",
        "feature-list.json": "draft"
      },
      "generator-frontend": {
        "plan.md": "draft",
        "api-contract.json": "draft",
        "feature-list.json": "draft"
      },
      "evaluator-code-quality": {
        "sprint-contract.md": "draft"
      },
      "evaluator-functional": {
        "sprint-contract.md": "draft"
      },
      "evaluator-visual": {
        "sprint-contract.md": "draft"
      }
    }
  },
  "session": {
    "isolation": true,
    "state_file": ".harness/progress.json",
    "state_log": ".harness/progress.log",
    "handoff_file": ".harness/handoff.json",
    "context_guard": {
      "comment": "컨텍스트 분리 하드 가드레일. UserPromptSubmit 훅이 위반을 감지하면 경고를 주입한다.",
      "enabled": true,
      "rules": [
        "current_agent가 running 상태일 때 다른 에이전트 스킬 호출 금지",
        "한 세션에서 2개 이상의 에이전트 스킬 실행 금지",
        "agent_status를 completed로 변경하지 않고 다음 에이전트를 호출하면 경고"
      ],
      "on_violation": "warn_and_block"
    }
  },
  "behavior": {
    "comment": "하네스 동작 플래그. UserPromptSubmit 훅이 이 값을 읽어 v7 CEO/CXX 라우팅 안내를 결정한다.",
    "auto_route_ceo": true,
    "auto_route_ceo_description": "true 이면 /goal 또는 /hot-fix 이후 Owner 입력을 v7 CEO/CXX mission flow 기준으로 안내한다. 사용자가 'harness skip' 등을 말하면 단일 메시지 한정으로 건너뛴다."
  },
  "token_limit": {
    "comment": "모델 토큰 제한으로 작업이 중단됐을 때의 저비용 재개 정책. 별도 probe 호출 없이 시간 기반으로만 재개 알림을 계산한다.",
    "stop_reason_flag": "TokenLimit",
    "retry_after_seconds": 3600,
    "re_notify_every_seconds": 3600,
    "owner": "session-start"
  },
  "company_mode": {
    "comment": "v7 — 회사모드는 항시 활성이다. Owner entrypoint는 /goal, /hot-fix이며 CEO가 CXX와 hired worker 흐름을 조정한다.",
    "default_mode": "company",
    "owner": "ceo",
    "worker_concurrency": 3,
    "worker_spawn": "claude",
    "worker_spawn_description": "claude 이면 idle worker 배정 시 `claude -p` 백그라운드 프로세스를 띄운다. record 로 두면 prompt/log만 생성한다.",
    "hourly_wake_executor": "claude",
    "hourly_wake_executor_description": "claude 이면 `claude -p`, codex 이면 `codex exec` 로 매시간 autonomous tick 을 실행한다.",
    "hourly_wake_mode": "headless",
    "hourly_wake_mode_description": "headless 는 백그라운드 실행, tmux 는 매시간 별도 tmux 세션, record 는 prompt/log만 생성한다.",
    "autonomous": true,
    "parallel_by_default": true
  },
  "runtime": {
    "ports": {
      "comment": "CEO가 Owner와 합의한 {xx}000 base port. .env 의 HARNESS_BASE_PORT 가 설정되지 않으면 OPS monitor 가 에러로 종료된다. CXX 는 이 값을 읽고 서비스별 포트를 base 이상 범위에서 배정한다.",
      "base_env": "HARNESS_BASE_PORT",
      "base": null,
      "range_size": 1000
    },
    "build": {
      "comment": "command 기반 build/dev 환경. flutter run, npm run dev 같은 실행 명령과 예상 포트/로그를 OPS 가 감시한다. live=true 로 바꾸기 전에 HARNESS_BASE_PORT 를 먼저 설정해야 한다.",
      "live": false,
      "commands": [
        {
          "name": "example-dev",
          "cwd": ".",
          "command": "npm run dev",
          "expected_port": null,
          "log_path": null,
          "owner": "cto",
          "cadence_seconds": 3600
        }
      ]
    },
    "play": {
      "comment": "/play-harness 가 실행하는 play mode command. release mode 와 공존할 수 없으며, scripts/play.sh 가 상호 배타 상태를 강제한다.",
      "cwd": ".",
      "command": ""
    },
    "release": {
      "comment": "/release-harness 가 실행하는 release operation command. play mode 와 공존할 수 없으며, scripts/release.sh 가 상호 배타 상태를 강제한다.",
      "cwd": ".",
      "command": ""
    },
    "production": {
      "comment": "Owner+CEO+CTO 합의로만 services[] 를 수정한다. local/docker/vm/aws/cloud 등 운영 서버 매핑을 Owner에게 받아 기록한다. live=true 이고 services[] 가 있으면 OPS 는 매 hourly review 마다 port/health/log 상태를 운영보고서에 남긴다.",
      "live": false,
      "services": [
        {
          "name": "example-api",
          "environment": "local",
          "host": "127.0.0.1",
          "port": null,
          "health_path": "/health",
          "expected_status": 200,
          "log_path": null,
          "owner": "cto",
          "source": "owner-provided",
          "cadence_seconds": 3600
        }
      ]
    }
  },
  "paths": {
    "actions": ".harness/actions",
    "archive": ".harness/archive",
    "gotchas": ".harness/gotchas",
    "conventions": "CONVENTIONS.md",
    "progress_state": ".harness/progress.json",
    "progress_log": ".harness/progress.log"
  },
  "audit": {
    "comment": "Audit log — 1 sprint cycle 단위의 실행 추적. Planner/Dispatcher 시작 시 리셋.",
    "file": ".harness/actions/audit.log",
    "lifecycle": "planner_to_eval_pass",
    "reset_on": ["planner", "dispatcher"],
    "archive_previous": true,
    "format": "TIMESTAMP | AGENT | ACTION | STATUS | TARGET | DETAIL",
    "actions": {
      "develop": "코드 생성/수정 (Generator)",
      "review": "검수/평가 (Evaluator)",
      "handoff": "에이전트 전환",
      "plan": "설계/계획 (Planner)",
      "gate": "자동 게이트 체크 (system)",
      "escalate": "에스컬레이션 (system)"
    },
    "statuses": ["start", "complete", "fail", "pass", "skip", "warn"]
  },
  "conventions": {
    "comment": "House-style registry. 루트 CONVENTIONS.md(사용자 자유 기술) + .harness/conventions/<scope>.md(Dispatcher 자동 누적). 모든 에이전트가 세션 시작 시 읽고 적용한다. Gotcha 의 긍정 대칭판.",
    "root_file": "CONVENTIONS.md",
    "scoped_dir": ".harness/conventions/",
    "scopes": ["shared", "planner", "generator-backend", "generator-frontend", "evaluator-code-quality", "evaluator-functional", "evaluator-visual"],
    "entry_id_prefix": "C",
    "read_by": "all_agents",
    "read_order": ["CONVENTIONS.md", ".harness/conventions/shared.md", ".harness/conventions/<self>.md", ".harness/gotchas/<self>.md", ".harness/memory.md"],
    "conflict_priority": "self > shared > root",
    "write_by": "dispatcher (auto-append C-NNN) or user_only (manual edit)",
    "read_timing": "session_start",
    "preserve_on_postinstall": true
  },
  "recommended_skills": {
    "comment": "Claude Code에 설치하면 하네스 품질이 향상되는 외부 스킬 목록",
    "vercel": {
      "description": "Vercel/Next.js 배포, 성능 최적화, AI SDK 가이드",
      "used_by": ["generator-frontend"],
      "install": "claude skill install vercel",
      "check_path": ".claude/skills/vercel"
    },
    "web-design-guidelines": {
      "description": "UI/UX 접근성, 디자인 리뷰, Web Interface Guidelines",
      "used_by": ["evaluator-visual", "generator-frontend"],
      "install": "claude skill install web-design-guidelines",
      "check_path": ".claude/skills/web-design-guidelines"
    },
    "taste-skill": {
      "description": "AI 생성 UI의 디자인 품질 검증, AI슬롭 패턴 감지",
      "used_by": ["evaluator-visual", "generator-frontend"],
      "install": "npx claude-skill install leonxlnx/taste-skill",
      "check_path": ".claude/skills/taste-skill"
    },
    "supanova-design-skill": {
      "description": "디자인 시스템 규칙, 컴포넌트 패턴, 시각적 일관성",
      "used_by": ["evaluator-visual", "generator-frontend"],
      "install": "npx claude-skill install uxjoseph/supanova-design-skill",
      "check_path": ".claude/skills/supanova-design-skill"
    }
  },
  "tech_stack": {
    "backend": {
      "framework": "NestJS (TypeScript)",
      "architecture": "MSA (Microservice Architecture)",
      "monorepo": "Nx 또는 Turborepo",
      "runner": "통합 러너 (단일 명령으로 전체 서비스 기동/종료)",
      "database": "PostgreSQL (dev: SQLite fallback 가능)",
      "api_gateway": "NestJS API Gateway 패턴",
      "transport": "TCP (dev) / RabbitMQ 또는 NATS (prod)"
    },
    "frontend": {
      "framework": "React 또는 Next.js (TypeScript)",
      "state": "Zustand 또는 TanStack Query",
      "styling": "Tailwind CSS"
    },
    "testing": {
      "e2e": "Playwright MCP (browser_* tools)",
      "backend_unit": "Jest (NestJS 내장)",
      "frontend_unit": "Vitest"
    }
  }
}
