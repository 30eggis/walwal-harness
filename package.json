{
  "name": "@walwal-harness/cli",
  "version": "7.1.40",
  "description": "Company-style AI agent harness for Claude and Codex. Installs commands, CXX agents, skills, HR-Resource hiring pool, and project-local .harness runtime state.",
  "bin": {
    "walwal-harness": "bin/init.js"
  },
  "scripts": {
    "init": "node bin/init.js",
    "scan": "bash scripts/scan-project.sh .",
    "import:agency-agents": "node scripts/import-agency-agents.js",
    "reset": "node bin/init.js --force"
  },
  "keywords": [
    "harness-engineering",
    "ai-agent",
    "claude-code",
    "codex",
    "skill",
    "command",
    "company-mode",
    "hr-resource",
    "hiring",
    "resource-manager",
    "ceo",
    "coo",
    "cdo",
    "cto",
    "cqo",
    "ops",
    "brick-office"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/30eggis/walwal-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/30eggis/walwal-harness.git"
  },
  "bugs": {
    "url": "https://github.com/30eggis/walwal-harness/issues"
  },
  "files": [
    "bin/",
    "HR-Resource/",
    "apps/harness-dashboard/app/",
    "apps/harness-dashboard/components/",
    "apps/harness-dashboard/hooks/",
    "apps/harness-dashboard/lib/",
    "apps/harness-dashboard/public/",
    "apps/harness-dashboard/*.json",
    "apps/harness-dashboard/*.js",
    "apps/harness-dashboard/*.mjs",
    "apps/harness-dashboard/*.ts",
    "apps/harness-dashboard/*.tsx",
    "scripts/",
    "commands/",
    "assets/",
    "gotchas/",
    "conventions/",
    "init.sh",
    "CHANGELOG.md"
  ]
}
