{
  "service": "harness-dashboard",
  "base_path": "/api",
  "transport": {
    "snapshot": "HTTP GET (application/json)",
    "stream": "HTTP GET (text/event-stream, SSE)"
  },
  "endpoints": [
    {
      "id": "GET-snapshot",
      "method": "GET",
      "path": "/api/snapshot",
      "summary": "초기 풀 로드용. 현재 .harness/ 상태의 단일 스냅샷 반환.",
      "request": { "query": {}, "body": null },
      "responses": {
        "200": { "schema": "HarnessSnapshot" }
      },
      "errors": {
        "comment": "절대 5xx 로 떨어지지 않음. 손상/누락 시에도 200 + state.errorBanner 필드 포함."
      }
    },
    {
      "id": "GET-stream",
      "method": "GET",
      "path": "/api/stream",
      "summary": "SSE 라이브 스트림. chokidar 가 .harness/ 변경을 감지하면 풀 스냅샷을 다시 송출.",
      "request": { "query": {}, "headers": { "Accept": "text/event-stream" }, "body": null },
      "responses": {
        "200": {
          "content_type": "text/event-stream",
          "messages": [
            {
              "event": "snapshot",
              "schema": "HarnessSnapshot",
              "comment": "최초 연결 시 1회. 이후 .harness/ 변경마다 재송출."
            }
          ]
        }
      },
      "errors": {
        "comment": "워처 에러 시에도 stream 닫지 않음. 마지막으로 알려진 snapshot 을 errorBanner 와 함께 송출."
      }
    }
  ],
  "schemas": {
    "HarnessSnapshot": {
      "type": "object",
      "required": ["version", "ts", "agents", "rooms", "goal", "archive", "meetings", "errorBanner"],
      "properties": {
        "version": { "type": "string", "description": "스냅샷 포맷 버전. 첫 릴리즈 = '1.0.0'." },
        "ts": { "type": "string", "format": "ISO-8601" },
        "agents": { "type": "array", "items": { "$ref": "#/schemas/AgentState" } },
        "rooms": { "type": "array", "items": { "$ref": "#/schemas/RoomState" } },
        "goal": { "oneOf": [{ "$ref": "#/schemas/GoalCard" }, { "type": "null" }] },
        "archive": { "$ref": "#/schemas/ArchiveStat" },
        "meetings": { "$ref": "#/schemas/MeetingsState" },
        "errorBanner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["level", "message_ko", "message_en"],
              "properties": {
                "level": { "enum": ["info", "warn", "error"] },
                "message_ko": { "type": "string" },
                "message_en": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "AgentState": {
      "type": "object",
      "required": ["id", "name", "dept", "room", "minifigState"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "dispatcher", "conductor", "meeting-manager", "planner",
            "generator-backend", "generator-frontend", "generator-designer", "generator-devops",
            "cqo",
            "evaluator-functional", "evaluator-visual", "evaluator-code-quality",
            "evaluator-architecture", "evaluator-security",
            "service-ops"
          ]
        },
        "name": { "type": "string", "description": "한국어 라벨 (예: 'CEO (Dispatcher)')" },
        "dept": { "enum": ["CEO", "Meeting", "Planner", "CTO", "CQO", "Operations"] },
        "room": { "enum": ["ceo", "meeting", "coo", "cto-team", "cqo-team", "service-ops", "archive"] },
        "minifigState": { "enum": ["idle", "typing", "talking", "red-alert"] },
        "lastActivity": { "type": "string", "description": "최신 progress.log 한 줄 또는 null" },
        "talkingPreview": { "type": "string", "description": "talking 상태에서 말풍선에 띄울 짧은 텍스트 (truncate)" },
        "alertReason": { "type": "string", "description": "red-alert 사유 (failure.message 또는 incident id)" }
      }
    },
    "RoomState": {
      "type": "object",
      "required": ["id", "label_ko", "label_en", "dept"],
      "properties": {
        "id": { "enum": ["ceo", "meeting", "coo", "cto-team", "cqo-team", "service-ops", "archive"] },
        "label_ko": { "type": "string" },
        "label_en": { "type": "string" },
        "dept": { "type": "string" },
        "metrics": {
          "type": "object",
          "description": "부서별 메트릭 (drawer room-metrics 탭 데이터)",
          "properties": {
            "sprint_number": { "type": "integer" },
            "last_review": { "type": ["string", "null"] },
            "last_audit": { "type": ["string", "null"] },
            "last_check": { "type": ["string", "null"] },
            "sprint_verdict": { "enum": ["pending", "PASS", "FAIL"] },
            "open_alerts": { "type": "integer" },
            "open_arch_risks": { "type": "integer" },
            "open_regressions": { "type": "integer" }
          }
        },
        "seatLayout": {
          "type": "object",
          "description": "회의실에서만 의미. 좌석 좌표 + wraparound 카운터.",
          "properties": {
            "seats": { "type": "integer", "default": 7 },
            "occupants": { "type": "array", "items": { "type": "string" } },
            "overflow": { "type": "integer" }
          }
        }
      }
    },
    "GoalCard": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description_truncated": { "type": "string", "description": "200자 truncate, 끝에 '…'" },
        "adherence": { "type": ["number", "null"], "description": "0~1, progress.json.goals.current_adherence" }
      }
    },
    "ArchiveStat": {
      "type": "object",
      "required": ["sprintCount", "recent"],
      "properties": {
        "sprintCount": { "type": "integer" },
        "recent": {
          "type": "array",
          "description": "최근 3개 sprint 라벨 (디렉토리명).",
          "items": {
            "type": "object",
            "required": ["dir", "label", "result"],
            "properties": {
              "dir": { "type": "string" },
              "label": { "type": "string" },
              "result": { "enum": ["PASS", "FAIL", "unknown"] },
              "ts": { "type": ["string", "null"] }
            }
          }
        },
        "all": {
          "type": "array",
          "description": "drawer archive-list 탭에서 사용. 전체 목록.",
          "items": { "$ref": "#/schemas/ArchiveStat/properties/recent/items" }
        }
      }
    },
    "MeetingsState": {
      "type": "object",
      "required": ["active", "cadence"],
      "properties": {
        "active": { "type": "array", "items": { "type": "string", "description": "agent id" } },
        "cadence": { "type": "string" },
        "next_scheduled": { "type": ["string", "null"] }
      }
    }
  },
  "client_contract": {
    "comment": "프론트엔드는 초기 GET /api/snapshot 1회 + GET /api/stream EventSource. 양방향 메시지 없음.",
    "sse_reconnect": "EventSource 자동 재접속 사용. 5회 연속 실패 시 사용자 토스트.",
    "stale_threshold_ms": 5000
  }
}
