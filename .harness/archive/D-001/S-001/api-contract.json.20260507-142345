{
  "service": "harness-dashboard",
  "base_path": "/api",
  "version": "1.1.0",
  "version_changes_from_1_0_0": [
    "AgentState 에 homeRoom: RoomId 추가 (Sprint 1 CR-001 retroactive 반영)",
    "GET /api/stream SSE endpoint 명세 명확화 (이벤트 타입 + 재접속 정책)"
  ],
  "transport": {
    "snapshot": "HTTP GET (application/json)",
    "stream": "HTTP GET (text/event-stream, SSE)"
  },
  "endpoints": [
    {
      "id": "GET-snapshot",
      "method": "GET",
      "path": "/api/snapshot",
      "summary": "초기 풀 로드용. 현재 .harness/ 상태의 단일 스냅샷 반환.",
      "request": { "query": {}, "body": null },
      "responses": { "200": { "schema": "HarnessSnapshot" } },
      "errors": { "comment": "절대 5xx 로 떨어지지 않음. 손상/누락 시에도 200 + state.errorBanner 필드 포함." }
    },
    {
      "id": "GET-stream",
      "method": "GET",
      "path": "/api/stream",
      "summary": "SSE 라이브 스트림. chokidar 가 .harness/ 변경을 감지하면 풀 스냅샷을 재송출.",
      "request": { "query": {}, "headers": { "Accept": "text/event-stream" }, "body": null },
      "responses": {
        "200": {
          "content_type": "text/event-stream",
          "messages": [
            {
              "event": "snapshot",
              "schema": "HarnessSnapshot",
              "comment": "최초 연결 시 1회. 이후 .harness/ 변경마다 재송출."
            }
          ],
          "reconnect": "EventSource 자동 재접속 사용. 서버는 재접속 시 첫 메시지로 풀 스냅샷 송출."
        }
      },
      "errors": { "comment": "워처 에러 시에도 stream 닫지 않음. 마지막으로 알려진 snapshot 을 errorBanner 와 함께 송출." }
    }
  ],
  "schemas": {
    "HarnessSnapshot": {
      "type": "object",
      "required": ["version", "ts", "agents", "rooms", "goal", "archive", "meetings", "errorBanner"],
      "properties": {
        "version": { "type": "string", "description": "스냅샷 포맷 버전. 현재 '1.1.0'." },
        "ts": { "type": "string", "format": "ISO-8601" },
        "agents": { "type": "array", "items": { "$ref": "#/schemas/AgentState" } },
        "rooms": { "type": "array", "items": { "$ref": "#/schemas/RoomState" } },
        "goal": { "oneOf": [{ "$ref": "#/schemas/GoalCard" }, { "type": "null" }] },
        "archive": { "$ref": "#/schemas/ArchiveStat" },
        "meetings": { "$ref": "#/schemas/MeetingsState" },
        "errorBanner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["level", "message_ko", "message_en"],
              "properties": {
                "level": { "enum": ["info", "warn", "error"] },
                "message_ko": { "type": "string" },
                "message_en": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "AgentState": {
      "type": "object",
      "required": ["id", "name", "dept", "room", "homeRoom", "minifigState"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "dispatcher", "conductor", "meeting-manager", "planner",
            "generator-backend", "generator-frontend", "generator-designer", "generator-devops",
            "evaluator-functional", "evaluator-visual", "evaluator-code-quality",
            "evaluator-architecture", "evaluator-security",
            "service-ops"
          ]
        },
        "name": { "type": "string", "description": "한국어 라벨 (예: 'CEO (Dispatcher)')" },
        "dept": { "enum": ["CEO", "Meeting", "Planner", "CTO", "CQO", "Operations"] },
        "room": { "enum": ["ceo", "meeting", "coo", "cto-team", "cqo-team", "service-ops", "archive"] },
        "homeRoom": {
          "enum": ["ceo", "meeting", "coo", "cto-team", "cqo-team", "service-ops", "archive"],
          "description": "에이전트의 원래 룸. talking 시 room 이 'meeting' 으로 바뀌어도 homeRoom 은 유지되어 미팅 종료 후 복귀 위치 결정에 사용."
        },
        "minifigState": { "enum": ["idle", "typing", "talking", "red-alert"] },
        "lastActivity": { "type": ["string", "null"] },
        "talkingPreview": { "type": "string" },
        "alertReason": { "type": "string" }
      }
    },
    "RoomState": {
      "type": "object",
      "required": ["id", "label_ko", "label_en", "dept"],
      "properties": {
        "id": { "enum": ["ceo", "meeting", "coo", "cto-team", "cqo-team", "service-ops", "archive"] },
        "label_ko": { "type": "string" },
        "label_en": { "type": "string" },
        "dept": { "type": "string" },
        "metrics": { "type": "object" },
        "seatLayout": { "type": "object" }
      }
    },
    "GoalCard": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description_truncated": { "type": "string" },
        "adherence": { "type": ["number", "null"] }
      }
    },
    "ArchiveStat": {
      "type": "object",
      "required": ["sprintCount", "recent"],
      "properties": {
        "sprintCount": { "type": "integer" },
        "recent": { "type": "array" },
        "all": { "type": "array" }
      }
    },
    "MeetingsState": {
      "type": "object",
      "required": ["active", "cadence"],
      "properties": {
        "active": { "type": "array", "items": { "type": "string" } },
        "cadence": { "type": "string" },
        "next_scheduled": { "type": ["string", "null"] }
      }
    }
  },
  "client_contract": {
    "comment": "초기 GET /api/snapshot 1회 + GET /api/stream EventSource. 양방향 메시지 없음.",
    "sse_reconnect": "EventSource 자동 재접속. 5회 연속 실패 시 사용자 토스트.",
    "stale_threshold_ms": 5000
  }
}
