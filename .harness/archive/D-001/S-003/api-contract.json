{
  "service": "harness-dashboard",
  "base_path": "/api",
  "version": "1.2.0",
  "version_history": {
    "1.0.0": "Sprint 1 — 초기 GET /api/snapshot",
    "1.1.0": "Sprint 2 — AgentState.homeRoom 추가 (CR-001 retroactive) + GET /api/stream 명세화",
    "1.2.0": "Sprint 3 — GET /api/log 정식 등재 (CR-002 반영)"
  },
  "transport": {
    "snapshot": "HTTP GET (application/json)",
    "stream": "HTTP GET (text/event-stream, SSE)",
    "log": "HTTP GET (application/json)"
  },
  "endpoints": [
    {
      "id": "GET-snapshot",
      "method": "GET",
      "path": "/api/snapshot",
      "summary": "초기 풀 로드용. 현재 .harness/ 상태의 단일 스냅샷.",
      "request": { "query": {}, "body": null },
      "responses": { "200": { "schema": "HarnessSnapshot" } },
      "errors": { "comment": "절대 5xx 로 떨어지지 않음. 손상/누락 시에도 200 + errorBanner." }
    },
    {
      "id": "GET-stream",
      "method": "GET",
      "path": "/api/stream",
      "summary": "SSE 라이브 스트림.",
      "request": { "headers": { "Accept": "text/event-stream" }, "body": null },
      "responses": {
        "200": {
          "content_type": "text/event-stream",
          "messages": [
            { "event": "snapshot", "schema": "HarnessSnapshot", "comment": "최초 + 변경마다." }
          ],
          "reconnect": "EventSource 자동 재접속. 재접속 시 풀 snapshot 재송출."
        }
      },
      "errors": { "comment": "워처 에러 시에도 stream 닫지 않음." }
    },
    {
      "id": "GET-log",
      "method": "GET",
      "path": "/api/log",
      "summary": "progress.log 의 라인을 agentId 로 필터링하여 반환. 드로어 agent-log 탭의 lazy fetch.",
      "request": {
        "query": {
          "agent": { "type": "string", "required": false, "description": "에이전트 id 로 라인 필터" },
          "limit": { "type": "integer", "required": false, "default": 50, "min": 1, "max": 500 }
        },
        "body": null
      },
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "required": ["agentId", "lines"],
            "properties": {
              "agentId": { "type": ["string", "null"] },
              "lines": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "errors": { "comment": "progress.log 부재 시 lines=[] 반환 (no 5xx)." }
    }
  ],
  "schemas": {
    "HarnessSnapshot": {
      "type": "object",
      "required": ["version", "ts", "agents", "rooms", "goal", "archive", "meetings", "errorBanner"],
      "properties": {
        "version": { "type": "string", "description": "현재 '1.2.0' (snapshot payload version)." },
        "ts": { "type": "string", "format": "ISO-8601" },
        "agents": { "type": "array", "items": { "$ref": "#/schemas/AgentState" } },
        "rooms": { "type": "array", "items": { "$ref": "#/schemas/RoomState" } },
        "goal": { "oneOf": [{ "$ref": "#/schemas/GoalCard" }, { "type": "null" }] },
        "archive": { "$ref": "#/schemas/ArchiveStat" },
        "meetings": { "$ref": "#/schemas/MeetingsState" },
        "errorBanner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["level", "message_ko", "message_en"],
              "properties": {
                "level": { "enum": ["info", "warn", "error"] },
                "message_ko": { "type": "string" },
                "message_en": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "AgentState": {
      "type": "object",
      "required": ["id", "name", "dept", "room", "homeRoom", "minifigState"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "dispatcher", "conductor", "meeting-manager", "planner",
            "generator-backend", "generator-frontend", "generator-designer", "generator-devops",
            "evaluator-functional", "evaluator-visual", "evaluator-code-quality",
            "evaluator-architecture", "evaluator-security",
            "service-ops"
          ]
        },
        "name": { "type": "string" },
        "dept": { "enum": ["CEO", "Meeting", "Planner", "CTO", "CQO", "Operations"] },
        "room": { "enum": ["ceo", "meeting", "coo", "cto-team", "cqo-team", "service-ops", "archive"] },
        "homeRoom": { "enum": ["ceo", "meeting", "coo", "cto-team", "cqo-team", "service-ops", "archive"] },
        "minifigState": { "enum": ["idle", "typing", "talking", "red-alert"] },
        "lastActivity": { "type": ["string", "null"] },
        "talkingPreview": { "type": "string" },
        "alertReason": { "type": "string" }
      }
    },
    "RoomState": {
      "type": "object",
      "required": ["id", "label_ko", "label_en", "dept"],
      "properties": {
        "id": { "enum": ["ceo", "meeting", "coo", "cto-team", "cqo-team", "service-ops", "archive"] },
        "label_ko": { "type": "string" },
        "label_en": { "type": "string" },
        "dept": { "type": "string" },
        "metrics": { "type": "object" },
        "seatLayout": { "type": "object" }
      }
    },
    "GoalCard": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description_truncated": { "type": "string" },
        "adherence": { "type": ["number", "null"] }
      }
    },
    "ArchiveStat": {
      "type": "object",
      "required": ["sprintCount", "recent"],
      "properties": {
        "sprintCount": { "type": "integer" },
        "recent": { "type": "array" },
        "all": { "type": "array" }
      }
    },
    "MeetingsState": {
      "type": "object",
      "required": ["active", "cadence"],
      "properties": {
        "active": { "type": "array", "items": { "type": "string" } },
        "cadence": { "type": "string" },
        "next_scheduled": { "type": ["string", "null"] }
      }
    }
  }
}
